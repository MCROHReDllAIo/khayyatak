# Khayyatak (خياطك) — Environment Configuration
# Copy to .env.local and fill in real values. Never commit secrets.

# ─── Supabase (REQUIRED) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── AI Provider (REQUIRED for AI features) ───
# Use an INFERENCE API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# Direct providers (alternative to OpenRouter)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional integrations ───
# PAYMENT_PROVIDER_KEY=
# EMAIL_PROVIDER_KEY=
# TRYON_AI_PROVIDER_KEY=
