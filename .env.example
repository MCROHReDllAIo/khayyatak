# Khayyatak (خياطك) — Environment Configuration
# Copy to .env.local and fill in real values. Never commit secrets.

# ─── PostgreSQL (Railway / Vercel Postgres) ───
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@host:port/railway

# ─── Supabase (REQUIRED for Auth + client SDK) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── AI Provider (REQUIRED for real AI — Inference key only) ───
# Create at https://openrouter.ai/keys — NOT a Management/Provisioning key
# Run: npm run setup:openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# Direct providers (alternative to OpenRouter)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─── Auth (PostgreSQL mode) ───
AUTH_SECRET=

# ─── App ───
NEXT_PUBLIC_APP_URL=https://kytk.online

# ─── Optional integrations ───
# PAYMENT_PROVIDER_KEY=
# EMAIL_PROVIDER_KEY=
# TRYON_AI_PROVIDER_KEY=
